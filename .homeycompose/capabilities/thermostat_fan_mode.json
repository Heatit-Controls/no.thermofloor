                  "title": {
                    "en": "Medium",
                    "nl": "Middel"
                  }
                },
                                {
                  "id": "Auto medium",
                  "title": {
                    "en": "Auto"
                  }
                },
                {
                  "id": "High",
                  "title": {
                    "en": "High",
                    "nl": "Hoog"
                  }
                }
